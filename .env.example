# Where the PugBuild web app (and its /api/v1) lives.
# Phone + Expo Go: use the Mac's LAN IP for local dev, or the preview deployment for demo data.
EXPO_PUBLIC_API_URL=https://pugbuild-web-git-development-heluansantos-projects.vercel.app
# Only when the preview is behind Vercel Authentication: Project → Settings → Deployment Protection → Protection Bypass for Automation.
# EXPO_PUBLIC_VERCEL_BYPASS=
# Pusher Channels public key + cluster (same as the web NEXT_PUBLIC_PUSHER_*). Without it the app polls instead.
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=us2
# Release builds hide the server switcher. Set to 1 only for internal demo builds.
# EXPO_PUBLIC_ALLOW_SERVER_SWITCH=1
# iOS: build Expo modules from source; the precompiled frameworks crash at launch on this SDK.
EXPO_USE_PRECOMPILED_MODULES=0
