{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pugbuild-web-git-development-heluansantos-projects.vercel.app",
        "EXPO_PUBLIC_ALLOW_SERVER_SWITCH": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pugbuild-web-git-development-heluansantos-projects.vercel.app",
        "EXPO_PUBLIC_ALLOW_SERVER_SWITCH": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://pugbuild.com" }
    }
  },
  "submit": { "production": {} }
}
