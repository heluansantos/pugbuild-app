{
  "expo": {
    "name": "PugBuild",
    "slug": "pugbuild",
    "version": "0.1.0",
    "scheme": "pugbuild",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F3EF",
    "ios": {
      "bundleIdentifier": "com.pugbuild.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PugBuild uses your location while the app is open to show the nearest job site and to record where you clock in and out. It is never tracked in the background.",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze"
        ]
      },
      "appleTeamId": "66CUAK7CAS",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.pugbuild.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4F3EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "en": "./assets/locales/en.json",
      "pt": "./assets/locales/pt.json",
      "es": "./assets/locales/es.json"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F4F3EF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PugBuild uses your location while the app is open to show the nearest job site and to record where you clock in and out. It is never tracked in the background.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "PugBuild uses your photos for your profile picture, job site updates and finished-task photos you choose to share.",
          "cameraPermission": "PugBuild uses the camera for your profile picture, job site updates and photos of finished tasks.",
          "microphonePermission": false
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
